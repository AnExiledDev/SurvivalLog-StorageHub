<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ToolkitDll Condition="'$(ToolkitDll)' == ''">D:\devnew\game-mods\SurvivalLog\mods\sl-exiled-toolkit\src\ExiledToolkit\bin\Release\ExiledToolkit.dll</ToolkitDll>
    <!-- Exiled's Toolkit's source folder, the one its built DLL sits two folders under (bin\Release). -->
    <ToolkitSrc>$([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('$(ToolkitDll)'))))))</ToolkitSrc>
  </PropertyGroup>

  <!-- The pure core is compiled straight in, with the Toolkit's plain helpers it uses, so the tests need none of the game or BepInEx assemblies. -->
  <ItemGroup>
    <Compile Include="..\..\src\StorageHub\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="$(ToolkitSrc)\Core\JsText.cs" Link="Toolkit\JsText.cs" />
    <Compile Include="$(ToolkitSrc)\Core\Phrase.cs" Link="Toolkit\Phrase.cs" />
    <Compile Include="$(ToolkitSrc)\Core\SlicedJob.cs" Link="Toolkit\SlicedJob.cs" />
    <EmbeddedResource Include="..\..\src\StorageHub\page.js" LogicalName="StorageHub.page.js" Link="page.js" />
    <!-- The Toolkit's page API, which page.js uses, from the Toolkit's source. -->
    <EmbeddedResource Include="$(ToolkitSrc)\api.js" LogicalName="ExiledToolkit.api.js" Link="Toolkit\api.js" />
    <!-- A fake Root.html for page.js, run in Jint. -->
    <EmbeddedResource Include="PageFake.js" LogicalName="StorageHub.Tests.PageFake.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
